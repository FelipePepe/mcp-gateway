{
  "name": "mcp-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Unified MCP gateway — aggregates all MCPs via docker exec",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^4.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "lefthook": "^2.1.6",
    "tsx": "^4.7.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
